# ──────────────────────────────────────────────────────────────
# ShortClipr — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# In production, inject via Google Secret Manager.
# ──────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,https://shortclipr.com

# ── Google OAuth 2.0 ───────────────────────────────────────────
# GCP Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── JWT ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google Cloud ───────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_INPUT=shortclipr-input-videos
GCS_BUCKET_OUTPUT=shortclipr-output-clips
FIRESTORE_DATABASE=(default)
# For local dev only (in prod, Cloud Run uses the service account automatically)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Upstash Redis ──────────────────────────────────────────────
# https://console.upstash.com → Create Database → REST URL + Token
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token
REDIS_JOB_QUEUE=shortclipr:jobs

# ── OpenAI (Worker only) ───────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ── Dodo Payments ──────────────────────────────────────────────
# https://dashboard.dodopayments.com → API Keys
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_ENV=test
# Webhook secret from Dodo dashboard → Webhooks → Secret
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret

# Product IDs (from Dodo dashboard → Products)
DODO_PRODUCT_PRO_50=prod_xxx
DODO_PRODUCT_PRO_100=prod_xxx
DODO_PRODUCT_PRO_200=prod_xxx
DODO_PRODUCT_PRO_400=prod_xxx
DODO_PRODUCT_PRO_500=prod_xxx
