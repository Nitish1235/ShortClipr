# ──────────────────────────────────────────────────────────────────────────────
# ShortClipr — Environment Variables
# Copy to .env and fill in your values.
# In production, inject via Google Secret Manager (see DEPLOYMENT.md).
# NEVER commit this file with real values.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,https://shortclipr.com

# ── Google OAuth 2.0 ───────────────────────────────────────────────────────────
# GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-32-char-random-hex-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Supabase (Users, Jobs, Clips — Postgres) ───────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection String → URI tab
# Set password in the URI directly (replace [YOUR-PASSWORD])
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# ── Google Cloud Storage (video files only) ────────────────────────────────────
# GCS is still used for storing uploaded videos and generated clip URLs
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_INPUT=shortclipr-input-videos
GCS_BUCKET_OUTPUT=shortclipr-output-clips
# Local dev only — not needed in Cloud Run (uses workload identity)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Upstash Redis (Job Queue) ──────────────────────────────────────────────────
# https://console.upstash.com → Create Database → REST API section
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token
REDIS_JOB_QUEUE=shortclipr:jobs

# ── OpenAI (Worker only — Whisper + GPT-4o) ───────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ── Dodo Payments ──────────────────────────────────────────────────────────────
# https://dashboard.dodopayments.com → API Keys
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_ENV=test
# Dodo Dashboard → Webhooks → copy the Signing Secret
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret

# Product IDs from Dodo Dashboard → Products
DODO_PRODUCT_PRO_50=prod_xxx
DODO_PRODUCT_PRO_100=prod_xxx
DODO_PRODUCT_PRO_200=prod_xxx
DODO_PRODUCT_PRO_400=prod_xxx
DODO_PRODUCT_PRO_500=prod_xxx

# ── Frontend (Next.js) ─────────────────────────────────────────────────────────
# In production, these must be passed as Substitution Variables 
# in your Cloud Build trigger settings (see DEPLOYMENT.md)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
