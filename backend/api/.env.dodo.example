# ─── Dodo Payments ────────────────────────────────────────────────────────────
# Get these from https://dashboard.dodopayments.com/developers

# Your secret API key
DODO_PAYMENTS_API_KEY=sk_test_...

# Environment: "test_mode" during development, "live_mode" in production
DODO_ENV=test_mode

# Webhook signing secret (from Dodo dashboard → Webhooks → your endpoint)
DODO_WEBHOOK_SECRET=whsec_...

# Product IDs — create these products in your Dodo dashboard first
# Set price on the product itself in the Dodo dashboard
DODO_PRODUCT_PRO_50=prod_...    # $10/mo · 50 shorts
DODO_PRODUCT_PRO_100=prod_...   # $19/mo · 100 shorts
DODO_PRODUCT_PRO_200=prod_...   # $30/mo · 200 shorts
DODO_PRODUCT_PRO_400=prod_...   # $49/mo · 400 shorts
DODO_PRODUCT_PRO_500=prod_...   # $57/mo · 500 shorts
